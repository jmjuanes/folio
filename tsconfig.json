{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "allowJs": true,
        "allowImportingTsExtensions": true,
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "noEmit": true,
        "paths": {
            "@profile": [
                "./profiles/development.ts"
            ],
        }
    },
    "exclude": [
        "node_modules/**/*",
        "**/*.jsx?",
        "workers/**/*"
    ]
}